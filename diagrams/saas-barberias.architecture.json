  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "SPA React 19 + Vite 8 + Tailwind v4 en Vercel",
        "Panel: Dashboard, Agenda, Ventas, Clientes, QR, Ajustes y Personalización",
        "Página pública /c/:slug con reserva online y pago opcional en el checkout hosteado de Mercado Pago"
      ]
    },
    {
      "dot": "emerald",
      "title": "Datos",
      "items": [
        "RLS multi-tenant vía negocio_de_usuario() sobre el security-group",
        "RPC: reservar_turno (anónimo), horarios_ocupados, guardar credenciales MP/WA",
        "pg_cron cada minuto + pg_net fire-and-forget para recordatorios",
        "Supabase Storage (bucket negocio-imagenes) para logo y galería con UUIDs por negocio"
      ]
    },
    {
      "dot": "rose",
      "title": "Integraciones externas",
      "items": [
        "Mercado Pago: preferencia server-side + webhook que identifica al negocio; el cliente completa el pago en el checkout de MP",
        "WhatsApp Cloud API: template enviado al móvil del cliente; token guardado solo en la base de datos",
        "Supabase Auth con sesiones en localStorage"
      ]
    }
  ]
